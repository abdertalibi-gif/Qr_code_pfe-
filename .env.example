# ---------------------------------------------------------------------------
# Modele de configuration — AUCUN SECRET ICI.
# Copier ce fichier vers .env puis renseigner les vraies valeurs :
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Base de donnees (format URL PostgreSQL)
# Local  : postgresql://postgres@127.0.0.1:5432/presenceqr_db
# Distant: postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/presenceqr_db

# Cle secrete Django (generer une valeur unique, ne pas reutiliser celle de prod)
DJANGO_SECRET_KEY=change-me

# Debug (True uniquement en developpement)
DJANGO_DEBUG=True

# SMTP (Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=change-me@example.com
